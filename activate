#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Anakot dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `anakot` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-anakot-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `anakot pm
# install` and `anakot update` keep that check.
# ============================================================================
_ANAKOT_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_anakot_test_env="--test-environment"
_anakot_expect_extras=""
for _anakot_arg in "$@"; do
    if [ -n "$_anakot_expect_extras" ]; then
        _anakot_test_env="--test-environment=$_anakot_arg"
        _anakot_expect_extras=""
        continue
    fi
    case "$_anakot_arg" in
        --) break ;;
        --test-extras) _anakot_expect_extras=1 ;;
        --test-extras=*) _anakot_test_env="--test-environment=${_anakot_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_anakot_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _anakot_arg _anakot_test_env _anakot_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _anakot_arg _anakot_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_ANAKOT_REPO/scripts/_activation.sh"

if ! anakot_sync "$_ANAKOT_REPO" "$_anakot_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _anakot_test_env
    return 1 2>/dev/null || exit 1
fi
unset _anakot_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __ANAKOT_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_anakot_script="$(anakot_compose_env "$_ANAKOT_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _anakot_script
    return 1 2>/dev/null || exit 1
}
_anakot_keys="$(printf '%s\n' "$_anakot_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __ANAKOT_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__ANAKOT_SAVED_PATH="$PATH"
for _anakot_k in $_anakot_keys; do
    eval "__ANAKOT_SAVED_$_anakot_k=\"\${$_anakot_k+set}\""
    eval "__ANAKOT_PRIOR_$_anakot_k=\${$_anakot_k-__ANAKOT_UNSET__}"
done
anakot_apply_env "$_anakot_script"

# This checkout, not whichever `anakot` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__ANAKOT_WORKTREE="$_ANAKOT_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__ANAKOT_WORKTREE_NAME="$(git -C "$_ANAKOT_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__ANAKOT_WORKTREE_NAME" ] || [ "$__ANAKOT_WORKTREE_NAME" = HEAD ]; then
    __ANAKOT_WORKTREE_NAME="$(basename "$_ANAKOT_REPO")"
fi
__ANAKOT_SAVED_PS1="${PS1-__ANAKOT_UNSET__}"
__ANAKOT_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__ANAKOT_UNSET__}"

_anakot_worktree_here() {
    _anakot_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_anakot_top" && pwd -P)" = "$(cd "$__ANAKOT_WORKTREE" && pwd -P)" ]
}

anakot() {
    _anakot_worktree_here || {
        printf '%s\n' "anakot: $(pwd) is outside $__ANAKOT_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__ANAKOT_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" anakot "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe anakot "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python anakot "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe anakot "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python anakot "$@"
        else
            exec python anakot "$@"
        fi
    )
}

_anakot_prompt() {
    if [ "$__ANAKOT_SAVED_PS1" = "__ANAKOT_UNSET__" ]; then
        _anakot_base_ps1=""
    else
        _anakot_base_ps1="$__ANAKOT_SAVED_PS1"
    fi
    if _anakot_worktree_here; then
        PS1="($__ANAKOT_WORKTREE_NAME) $_anakot_base_ps1"
    else
        PS1="$_anakot_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_anakot_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_anakot_prompt
fi
_anakot_prompt

deactivate() {
    export PATH="$__ANAKOT_SAVED_PATH"
    for _anakot_k in $__ANAKOT_KEY_LIST; do
        eval "_anakot_was=\"\$__ANAKOT_SAVED_$_anakot_k\""
        eval "_anakot_old=\"\$__ANAKOT_PRIOR_$_anakot_k\""
        if [ "$_anakot_was" != "set" ]; then
            unset "$_anakot_k"
        else
            export "$_anakot_k=$_anakot_old"
        fi
        unset "__ANAKOT_SAVED_$_anakot_k" "__ANAKOT_PRIOR_$_anakot_k"
    done
    if [ "$__ANAKOT_SAVED_PS1" = "__ANAKOT_UNSET__" ]; then
        unset PS1
    else
        PS1="$__ANAKOT_SAVED_PS1"
    fi
    if [ "$__ANAKOT_SAVED_PROMPT_COMMAND" = "__ANAKOT_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__ANAKOT_SAVED_PROMPT_COMMAND"
    fi
    unset __ANAKOT_SAVED_PATH __ANAKOT_KEY_LIST __ANAKOT_ACTIVATED \
          __ANAKOT_WORKTREE __ANAKOT_WORKTREE_NAME \
          __ANAKOT_SAVED_PS1 __ANAKOT_SAVED_PROMPT_COMMAND
    unset -f deactivate anakot _anakot_worktree_here _anakot_prompt
    unset _anakot_k _anakot_was _anakot_old _anakot_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__ANAKOT_KEY_LIST="$_anakot_keys"

# The composition library is not part of the user's shell.
unset -f anakot_sync anakot_bootstrap_python anakot_compose_env anakot_apply_env \
         anakot_activation_current anakot_ensure_env
unset _ANAKOT_REPO _anakot_script _anakot_keys _anakot_k _anakot_top
