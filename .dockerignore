# Git
.git
.gitignore
.gitmodules

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/

# Dependencies
node_modules
**/node_modules
.venv
**/.venv
.notebooklm-cli-venv/
.notebooklm-playwright/
.pip-cache/
.uv-cache/

# Built artifacts that are regenerated inside the image.  Excluded so local
# rebuilds on the developer's machine don't invalidate the npm-install layer
# that now depends on the full ui-tui/packages/hermes-ink/ tree being present.
ui-tui/dist/
ui-tui/packages/hermes-ink/dist/

# CI/CD
.github

# Environment files
.env
.env.*
# ...but keep the template: docker/stage2-hook.sh seeds $HERMES_HOME/.env from
# /opt/hermes/.env.example on first boot (OOF-285 — excluding it silently broke
# first-boot .env seeding and the API_SERVER_KEY generation that depends on it).
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/

# Documentation
*.md

# Runtime data (bind-mounted at /data; must not leak into build context).
# Anchored to the root on purpose: a bare `data/` also matches ANY directory
# named data at any depth, which silently stripped website/src/data/ and broke
# the Docusaurus build with "Can't resolve '@site/src/data/userStories.json'".
/data/
.hermes-docker/
.notebooklm-home/

# Compose/profile runtime state (bind-mounted; avoid ownership/secret issues)
hermes-config/
runtime/

# ---------- Not needed inside the Docker image ----------

# Desktop app source (Tauri/Electron); never installed in the container.
# apps/shared is the dashboard↔desktop websocket helper and is linked from
# web/package.json as a file: workspace dep — keep it in the build context.
apps/
!apps/shared/
!apps/shared/**

# Test suite — not shipped in production images
tests/

# Documentation site (Docusaurus)
#
# The agent image does not need it; railway/Dockerfile.docs does. The `docs`
# Railway service builds it, so the source must reach the daemon.
#
# Negation alone is not enough here: Docker prunes an excluded directory and
# will not re-include anything beneath it, so `website/` + `!website/**` still
# ships an empty tree. The build also needs the .md/.mdx sources, which the
# top-level `*.md` rule would otherwise strip. Excluding website by default and
# re-including it wholesale (plus its doc sources) is the combination that
# actually works.
# Website (Docusaurus).
#
# Previously excluded outright, on the assumption that only the agent image
# builds here. That is wrong: railway/Dockerfile.docs builds the docs site from
# this same context, and BuildKit used the ROOT .dockerignore for it (a
# per-Dockerfile `railway/Dockerfile.docs.dockerignore` is not honoured by
# Railway's builder), so the docs build failed with
#   "/website/package.json": not found
# then, once re-included, "Can't resolve '@site/src/data/userStories.json'".
#
# The website source is ~27 MB and the only heavy parts are node_modules and a
# stale local build/, both excluded below. Shipping the source costs the agent
# image nothing (it never COPYs website/) and keeps one rule set for both.
!website/
website/node_modules/
website/node_modules/**
website/build/
website/build/**
website/.docusaurus/
website/.docusaurus/**
website/.cache/
website/.cache/**

# Docusaurus compiles its pages from .md/.mdx, and the blanket `*.md` rule
# above would otherwise strip every doc source and yield an empty site.
!website/**/*.md
!website/**/*.mdx

# Assets only used by the GitHub README
assets/
infographic/

# Plugin-level docs (hermes-achievements ships docs/ but the runtime doesn't read them)
plugins/hermes-achievements/docs/

# Nix / Homebrew / AUR packaging metadata — irrelevant to Docker
nix/
flake.nix
flake.lock
packaging/

# Design and planning documents
plans/
.plans/

# Repo-level dotfiles that are git-only or dev-tooling config
.envrc
.gitattributes
.hadolint.yaml
.mailmap

# Debug/export artifacts — must never reach image layers (COPY . .)
/log.txt
/sqlite_leak_fix.png
/*.png.bak
*.tar.gz
*.tgz
